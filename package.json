{
  "name": "red-tetris",
  "version": "1.0.0",
  "private": true,
  "description": "A networked multiplayer Tetris game",
  "main": "src/server/index.js",
  "scripts": {
    "build": "esbuild src/client/main.jsx --bundle --minify --outfile=public/bundle.js --loader:.css=css",
    "start": "npm run build && node src/server/index.js",
    "dev": "npm run build && node --watch src/server/index.js",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11"
  }
}
